# Provider selection: deterministic, openai-compatible, openai, or deepseek.
ZABM_PROVIDER=deterministic
ZABM_DEBUG=0
ZABM_OUTPUT_LANGUAGE=auto

# Korean output stays disabled until a separately reviewed sample set is approved.
ZABM_KOREAN_OUTPUT=0
# ZABM_KOREAN_SAMPLE_SET=/absolute/path/to/sample-set-v1.json
# ZABM_KOREAN_REVIEW=/absolute/path/to/review-v1.json

# Custom OpenAI-compatible endpoint.
ZABM_PROVIDER_URL=
ZABM_MODEL=
ZABM_EMBEDDING_MODEL=
ZABM_PROVIDER_CONFIGURATION=

# Optional separate embedding endpoint, such as local Ollama.
ZABM_EMBEDDING_PROVIDER_URL=
ZABM_EMBEDDING_PROVIDER_API_KEY=

# Optional generic override used by any provider profile.
ZABM_PROVIDER_API_KEY=

# OpenAI profile.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek profile.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_EMBEDDING_MODEL=not-configured
